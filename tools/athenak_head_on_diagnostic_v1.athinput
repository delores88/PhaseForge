# Proposed low-momentum initialization/evolution diagnostic; not 0.999c or a merger acceptance.
<comment>
problem = equal target puncture ADM masses, nonspinning inward momenta; no calibrated speed
<job>
basename = headon_low_momentum
<mesh>
nghost = 2
nx1 = 32
nx2 = 32
nx3 = 32
x1min = -15
x1max = 15
x2min = -15
x2max = 15
x3min = -15
x3max = 15
ix1_bc = outflow
ox1_bc = outflow
ix2_bc = outflow
ox2_bc = outflow
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<mesh_refinement>
refinement = static
num_levels = 5
<refined_region1>
level = 4
x1min = 2.2
x1max = 3.8
x2min = -0.8
x2max = 0.8
x3min = -0.8
x3max = 0.8
<refined_region2>
level = 4
x1min = -3.8
x1max = -2.2
x2min = -0.8
x2max = 0.8
x3min = -0.8
x3max = 0.8
<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.25
tlim = 1
nlim = 128
<z4c>
lapse_oplog = 2
lapse_harmonic = 0
lapse_advect = 1
slow_start_lapse = false
shift_eta = 2
shift_Gamma = 0.5
shift_advect = 1
shift_alpha2Gamma = 0
shift_H = 0
diss = 0.1
chi_div_floor = 1e-5
chi_min_floor = 1e-12
floor_chi = false
damp_kappa1 = 0.02
damp_kappa2 = 0
excise_chi = 0.0625
nco = 2
co_0_type = BH
co_0_x = 3
co_0_y = 0
co_0_z = 0
co_0_radius = 0.8
co_0_mass = 0.5
co_1_type = BH
co_1_x = -3
co_1_y = 0
co_1_z = 0
co_1_radius = 0.8
co_1_mass = 0.5
tracker_mode = ode
nrad_wave_extraction = 2
extraction_radius_0 = 8
extraction_radius_1 = 10
extraction_nlev = 5
waveform_dt = 0.25
<fastflow>
npunct = 2
num_horizons = 3
ntheta = 10
lmax = 6
flow = standard
use_puncture_0 = 0
use_puncture_1 = 1
use_puncture_2 = -1
center_x_0 = 3
center_y_0 = 0
center_z_0 = 0
center_x_1 = -3
center_y_1 = 0
center_z_1 = 0
center_x_2 = 0
center_y_2 = 0
center_z_2 = 0
initial_radius_0 = 0.3
initial_radius_1 = 0.3
initial_radius_2 = 4
start_time_0 = 0
start_time_1 = 0
start_time_2 = 0
stop_time_0 = 1
stop_time_1 = 1
stop_time_2 = 1
wait_until_punc_are_close_0 = false
wait_until_punc_are_close_1 = false
wait_until_punc_are_close_2 = false
flow_iterations_0 = 100
flow_iterations_1 = 100
flow_iterations_2 = 100
mass_tol_0 = 1e-6
mass_tol_1 = 1e-6
mass_tol_2 = 1e-6
hmean_tol_0 = 100
hmean_tol_1 = 100
hmean_tol_2 = 100
verbose = true
output_ylm = true
output_grid = true
<problem>
pgen_name = z4c_two_puncture
verbose = true
par_b = 3
par_m_plus = 0.5
par_m_minus = 0.5
target_M_plus = 0.5
target_M_minus = 0.5
give_bare_mass = false
par_P_plus1 = -0.025
par_P_plus2 = 0
par_P_plus3 = 0
par_P_minus1 = 0.025
par_P_minus2 = 0
par_P_minus3 = 0
par_S_plus1 = 0
par_S_plus2 = 0
par_S_plus3 = 0
par_S_minus1 = 0
par_S_minus2 = 0
par_S_minus3 = 0
center_offset1 = 0
center_offset2 = 0
center_offset3 = 0
npoints_A = 40
npoints_B = 40
npoints_phi = 20
Newton_tol = 1e-10
Newton_maxit = 20
adm_tol = 1e-10
TP_epsilon = 0
TP_Tiny = 0
TP_Extend_Radius = 0
do_residuum_debug_output = true
solve_momentum_constraint = false
initial_lapse_psi_exponent = -2
swap_xz = false
grid_setup_method = 1
<output1>
file_type = bin
variable = z4c
dt = 0.5
ghost_zones = false
<output2>
file_type = bin
variable = con
dt = 0.5
ghost_zones = false
<output3>
file_type = hst
dt = 0.25
<output4>
file_type = rst
dt = 1
