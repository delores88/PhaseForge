* text=auto
*.sh text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.rs text eol=lf
*.py text eol=lf
# Upstream notice hashes must survive Windows Git checkouts unchanged.
tools/third-party/openmm-8.5.2/*.txt text eol=lf
tools/third-party/msvc-runtime/*.txt text eol=lf
# Preserve the exact converted upstream license, including its original whitespace.
tools/third-party/msvc-runtime/Visual-Studio-2022-Community-License.txt -text -whitespace
*.png binary
*.jpg binary
*.ico binary
# Supplied SVG artwork is copied byte-for-byte; do not normalize its line endings.
frontend/public/*.svg -text
frontend/public/brand/*.svg -text
