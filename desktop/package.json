{
  "name": "phaseforge-desktop",
  "version": "0.8.0",
  "description": "Local scientific research and simulation workbench",
  "author": "Ben Van Dorn",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win:x64": "electron-builder --win nsis --x64 --publish never",
    "package:win:arm64": "electron-builder --win nsis --arm64 --publish never",
    "package:linux:x64": "electron-builder --linux AppImage deb --x64 --publish never",
    "package:linux:arm64": "electron-builder --linux AppImage deb --arm64 --publish never"
  },
  "devDependencies": {"electron": "44.3.0", "electron-builder": "26.15.3"},
  "build": {
    "appId": "science.phaseforge.desktop",
    "productName": "PhaseForge",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["main.cjs", "server.cjs", "package.json"],
    "extraResources": [
      {"from": "../frontend/out", "to": "ui"},
      {"from": "runtime/${os}/${arch}", "to": "runtime"},
      {"from": "../tools", "to": "tools", "filter": ["**/*.py"]}
    ],
    "win": {"target": "nsis", "icon": "../frontend/public/icon.png", "artifactName": "PhaseForge_${version}_${arch}-setup.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false},
    "linux": {"target": ["AppImage", "deb"], "icon": "../frontend/public/icon.png", "category": "Science", "artifactName": "PhaseForge_${version}_${arch}.${ext}", "maintainer": "Ben Van Dorn"},
    "publish": null
  }
}
